# Haar Plymouth theme: the emblem divides like a cell, 1 -> 2 -> 4 -> 8, then fades and starts again
# (the cloning idea). No text. Script-driven: no animation frames, nothing in the Secure Boot chain.
pi = 3.14159265;
bg = Image("background.png");
sw = Window.GetWidth(); sh = Window.GetHeight();
scale = Math.Max(sw / bg.GetWidth(), sh / bg.GetHeight());
bg = bg.Scale(bg.GetWidth() * scale, bg.GetHeight() * scale);
bg_sprite = Sprite(bg);
bg_sprite.SetPosition((sw - bg.GetWidth()) / 2, (sh - bg.GetHeight()) / 2, -100);

# Cell size per generation (as a fraction of base) and grid shape: 1x1, 2x1, 2x2, 4x2.
base = Math.Min(sw, sh) * 0.34;
gen_size[0] = base;        gen_cols[0] = 1; gen_rows[0] = 1;
gen_size[1] = base * 0.62; gen_cols[1] = 2; gen_rows[1] = 1;
gen_size[2] = base * 0.45; gen_cols[2] = 2; gen_rows[2] = 2;
gen_size[3] = base * 0.34; gen_cols[3] = 4; gen_rows[3] = 2;
cx = sw / 2; cy = sh / 2;

# Pre-scaled copies of the emblem, from biggest to smallest, so resizing is only a SetImage.
logo = Image("logo.png");
LEVELS = 24;
for (i = 0; i < LEVELS; i++) {
    s = gen_size[0] + (gen_size[3] - gen_size[0]) * i / (LEVELS - 1);
    lvl_size[i] = s;
    lvl_img[i] = logo.Scale(s, s);
}
fun level_for(size) {
    best = 0; bestd = 100000;
    for (i = 0; i < LEVELS; i++) {
        d = Math.Abs(lvl_size[i] - size);
        if (d < bestd) { bestd = d; best = i; }
    }
    return best;
}

# Grid column/row of cell k in generation g. Children 2p and 2p+1 of parent p sit where p was,
# split apart, which is what makes it read as division.
fun cell_col(g, k) {
    if (g == 0) return 0;
    if (g == 1) return k;
    if (g == 2) return Math.Int(k / 2);
    p = Math.Int(k / 2);
    return 2 * Math.Int(p / 2) + (k - 2 * p);
}
fun cell_row(g, k) {
    if (g == 0) return 0;
    if (g == 1) return 0;
    if (g == 2) return k - 2 * Math.Int(k / 2);
    p = Math.Int(k / 2);
    return p - 2 * Math.Int(p / 2);
}
fun cell_x(g, k, size) { return cx + (cell_col(g, k) - (gen_cols[g] - 1) / 2) * size * 1.06; }
fun cell_y(g, k, size) { return cy + (cell_row(g, k) - (gen_rows[g] - 1) / 2) * size * 1.06; }

for (k = 0; k < 8; k++) { cell[k] = Sprite(); cell[k].SetOpacity(0); cell_lvl[k] = -1; }

fun ease(p) { return (1 - Math.Cos(pi * p)) / 2; }

# Timeline in frames (about 50 per second): hold 1, split, hold, split, hold, split, hold, fade out.
T_HOLD0 = 60; T_SPLIT = 70; T_GAP = 25; T_END_HOLD = 90; T_FADE = 40;
t = 0;
fun refresh_cb() {
    global.t = t + 1;
    f = t;
    g = 0; e = 1; fade = 1;
    # Work out which division we are in (g = generation being split into, e = its progress 0..1).
    if (f < T_HOLD0) { g = 0; e = 1; fade = Math.Min(1, f / 30.0); }
    else {
        f = f - T_HOLD0;
        if (f < T_SPLIT) { g = 1; e = ease(f / T_SPLIT); }
        else {
            f = f - T_SPLIT - T_GAP;
            if (f < 0) { g = 1; e = 1; }
            else if (f < T_SPLIT) { g = 2; e = ease(f / T_SPLIT); }
            else {
                f = f - T_SPLIT - T_GAP;
                if (f < 0) { g = 2; e = 1; }
                else if (f < T_SPLIT) { g = 3; e = ease(f / T_SPLIT); }
                else {
                    f = f - T_SPLIT;
                    g = 3; e = 1;
                    if (f > T_END_HOLD) { fade = Math.Max(0, 1 - (f - T_END_HOLD) / T_FADE); }
                    if (f > T_END_HOLD + T_FADE) { global.t = 0; }
                }
            }
        }
    }
    pulse = 0.93 + 0.07 * Math.Sin(t / 18.0);
    n = 1; for (i = 0; i < g; i++) { n = n * 2; }
    for (k = 0; k < 8; k++) {
        if (k >= n) { cell[k].SetOpacity(0); }
        else {
            size = gen_size[g]; x = cell_x(g, k, size); y = cell_y(g, k, size); o = fade * pulse;
            if (g > 0) {
                # Blend from the parent's position and size to the new generation's.
                pk = Math.Int(k / 2);
                ps = gen_size[g - 1];
                px = cell_x(g - 1, pk, ps); py = cell_y(g - 1, pk, ps);
                size = ps + (gen_size[g] - ps) * e;
                x = px + (x - px) * e; y = py + (y - py) * e;
                if (k - 2 * pk == 1) { o = o * Math.Min(1, e * 4); }
            }
            l = level_for(size);
            if (l != cell_lvl[k]) { cell[k].SetImage(lvl_img[l]); global.cell_lvl[k] = l; }
            cell[k].SetPosition(x - lvl_size[l] / 2, y - lvl_size[l] / 2, 10);
            cell[k].SetOpacity(o);
        }
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

bar_w = sw * 0.3; bar_h = 4;
bar_img = Image("bar.png");
fill = Sprite();
fill_w = 1;
fill.SetPosition((sw - bar_w) / 2, sh * 0.9, 20);
fill.SetImage(bar_img.Scale(1, bar_h));
fun progress_cb(duration, progress) {
    w = Math.Max(1, bar_w * progress);
    if (Math.Abs(w - fill_w) > 2) {
        global.fill_w = w;
        fill.SetImage(bar_img.Scale(w, bar_h));
    }
}
Plymouth.SetBootProgressFunction(progress_cb);
