# Haar Plymouth theme. Background covers the screen; the emblem (logo.png, no text) sits in the
# middle and breathes: slow opacity pulse and a gentle float, plus a slim progress bar.
# Script-driven, so it adds no animation frames and is not part of Secure Boot's signed chain.
bg = Image("background.png");
sw = Window.GetWidth(); sh = Window.GetHeight();
scale = Math.Max(sw / bg.GetWidth(), sh / bg.GetHeight());
bg = bg.Scale(bg.GetWidth() * scale, bg.GetHeight() * scale);
bg_sprite = Sprite(bg);
bg_sprite.SetPosition((sw - bg.GetWidth()) / 2, (sh - bg.GetHeight()) / 2, -100);

logo = Image("logo.png");
size = Math.Min(sw, sh) * 0.36;
logo = logo.Scale(size, size);
logo_sprite = Sprite(logo);
logo_x = (sw - size) / 2;
logo_y = (sh - size) / 2;
logo_sprite.SetPosition(logo_x, logo_y, 10);

bar_w = sw * 0.3; bar_h = 4;
bar_img = Image("bar.png");
fill = Sprite();
fill_w = 1;
fill.SetPosition((sw - bar_w) / 2, sh * 0.9, 20);
fill.SetImage(bar_img.Scale(1, bar_h));

t = 0;
fun refresh_cb() {
    t = t + 1;
    pulse = Math.Sin(t / 40.0);
    logo_sprite.SetOpacity(0.82 + 0.18 * pulse);
    logo_sprite.SetPosition(logo_x, logo_y + pulse * 6, 10);
}
Plymouth.SetRefreshFunction(refresh_cb);

fun progress_cb(duration, progress) {
    w = Math.Max(1, bar_w * progress);
    if (Math.Abs(w - fill_w) > 2) {
        fill_w = w;
        fill.SetImage(bar_img.Scale(w, bar_h));
    }
}
Plymouth.SetBootProgressFunction(progress_cb);
